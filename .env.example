# Copia a .env (local) o cárgalas como Secrets en GitHub / Variables en Vercel.
UG_USER=tu_usuario_del_campus
UG_PASS=tu_contraseña
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=app_password_de_gmail_sin_espacios
MAIL_TO=destino1@gmail.com,destino2@gmail.com
# Opcional: correo para alertas de salud (por defecto, el primer MAIL_TO)
ADMIN_MAIL=admin@gmail.com
# Postgres (Neon). En Vercel se crea sola; en GitHub Actions cárgala como Secret.
DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require
# Horario de clases como JSON en una línea (ver horario.json). Solo para CI.
HORARIO_JSON=[{"materia":"...","courseId":0,"profesor":"...","dia":"lunes","inicio":"18:00","fin":"21:00"}]
